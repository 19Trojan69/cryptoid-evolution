{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node verification/direct-boss-style-device-20261102/installDevicePreview.mjs",
  "buildCommand": "node verification/direct-boss-style-device-20261102/buildDevicePreview.mjs",
  "outputDirectory": "verification/boss2-forensics-20261028/results/device-preview/site",
  "redirects": [
    {
      "source": "/stability-report.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/stability-report.mjs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-report.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-report.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-evidence.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-lifecycle.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-info.json",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
