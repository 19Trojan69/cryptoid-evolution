{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node -e \"if(process.env.VERCEL_ENV!=='preview')throw Error('Private preview only')\" && npm install --prefix frontend",
  "buildCommand": "node private-preview/build.mjs",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/stability-report.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/stability-report.mjs",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/white-screen-startup-recovery-20261023": false,
      "codex/idle-display-resume-guard-20261023": false,
      "codex/diagnostic-idb-callback-guard-20261023": false,
      "codex/shop-storage-audit-20261023": false,
      "codex/hull-load-release-record-20261023": false,
      "codex/hull-load-readiness-20261023": false,
      "codex/hull-stage-diagnostics-20261022": false,
      "codex/full-session-export-recovery-20261022": false,
      "codex/normal-transition-crash-audit-20261022": false,
      "codex/weapon-reload-recovery-20261022": false,
      "codex/canvas-static-url-release-record-20261022": false,
      "codex/canvas-static-url-readiness-20261022": false,
      "codex/static-hull-memory-release-record-20261022": false,
      "codex/static-hull-memory-20261022": false,
      "codex/audio-graph-initialization-20261022": false,
      "codex/hull-handoff-release-record-20261021": false,
      "codex/audio-clock-recovery-20261021": false,
      "codex/hull-preparation-handoff-20261021": false,
      "codex/owner-flight-release-record-20261021": false,
      "codex/owner-flight-recorder-20261021": false,
      "codex/effect-cleanup-release-record-20261021": false,
      "codex/testnet-effect-cleanup-release-20261021": false,
      "codex/spent-boss-weapon-cache-20261021": false,
      "codex/finished-hit-debris-cleanup-20261021": false,
      "codex/reactor-door-reuse-20261021": false,
      "codex/static-boss-glow-20261021": false,
      "codex/idle-rock-surface-20261021": false,
      "codex/boss-effect-audit-20261021": false,
      "codex/crash-diagnosis-20261015": false,
      "codex/testnet-stability-20261016": false,
      "codex/official-testnet-frame-audit-20261019": false,
      "codex/testnet-lazy-session-store-20261019": false,
      "codex/testnet-small-turret-bodies-20261019": false,
      "codex/iphone-lifetime-audit-20261020": false,
