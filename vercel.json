{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix frontend && npm install --include=optional --prefix backend",
  "buildCommand": "VITE_CRYPTOID_DIAGNOSTICS=0 npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "redirects": [
    { "source": "/stability-report.html", "destination": "/", "permanent": false },
    { "source": "/stability-report.mjs", "destination": "/", "permanent": false }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/node_modules/@img/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/static-hull-memory-20261022": false,
      "codex/audio-graph-initialization-20261022": false,
      "codex/hull-handoff-release-record-20261021": false,
      "codex/audio-clock-recovery-20261021": false,
      "codex/hull-preparation-handoff-20261021": false,
      "codex/owner-flight-release-record-20261021": false,
      "codex/owner-flight-recorder-20261021": false,
      "codex/effect-cleanup-release-record-20261021": false,
      "codex/testnet-effect-cleanup-release-20261021": false,
      "codex/spent-boss-weapon-cache-20261021": false,
      "codex/finished-hit-debris-cleanup-20261021": false,
      "codex/reactor-door-reuse-20261021": false,
      "codex/static-boss-glow-20261021": false,
      "codex/idle-rock-surface-20261021": false,
      "codex/boss-effect-audit-20261021": false,
      "codex/crash-diagnosis-20261015": false,
      "codex/testnet-stability-20261016": false,
      "codex/official-testnet-frame-audit-20261019": false,
      "codex/testnet-lazy-session-store-20261019": false,
      "codex/testnet-small-turret-bodies-20261019": false,
      "codex/iphone-lifetime-audit-20261020": false,
      "codex/audio-clock-release-record-20261021": false,
      "codex/audio-gesture-recovery-20261021": false,
      "codex/audio-gesture-release-record-20261021": false,
      "codex/post-interruption-audio-retry-20261021": false,
      "codex/post-interruption-audio-release-record-20261021": false,
      "codex/boss-victory-audio-progress-20261021": false,
      "codex/boss-victory-audio-release-record-20261021": false
    }
  }
}
