{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix frontend && npm install --include=optional --prefix backend",
  "buildCommand": "node frontend/scripts/buildPlayablePreview.mjs",
  "outputDirectory": "frontend/play-preview-dist",
  "redirects": [
    {
      "source": "/stability-report.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/stability-report.mjs",
      "destination": "/",
      "permanent": false
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/node_modules/@img/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/preview-api-disabled.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/crash-diagnosis-20261015": false,
      "codex/testnet-stability-20261016": false
    }
  }
}
