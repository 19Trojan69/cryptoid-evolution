{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix frontend && npm install --include=optional --prefix backend",
  "buildCommand": "VITE_CRYPTOID_DIAGNOSTICS=0 npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/stability-report.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/stability-report.mjs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-report.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-report.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-evidence.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-lifecycle.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private-preview-info.json",
      "destination": "/",
      "permanent": false
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/node_modules/@img/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/white-screen-startup-recovery-20261023": false,
