# Generate a random string, or roll your face on the keyboard to fill this value:
SESSION_SECRET=

# Get this on the Pi Developer Portal (https://develop.pinet.com in the Pi Browser)
PI_API_KEY=

# Platform API 
PLATFORM_API_URL=https://api.minepi.com

# MongoDB database connection details:
MONGO_HOST=localhost:27017
MONGODB_DATABASE_NAME=demoapp-development
MONGODB_USERNAME=demoapp
MONGODB_PASSWORD=dev_password

# Frontend app URL
FRONTEND_URL=http://localhost:3314
# Optional explicit Pi UID override; otherwise the first verified @19Trojan69 login binds automatically.
ADMIN_PI_UID=
# Optional separate UID pin for the Testnet Pi app (UIDs differ between apps).
ADMIN_PI_TESTNET_UID=

# Network-scoped keys, actual app/wallet values and reviewed evidence are
# described in docs/mainnet-evidence-contract.md. Never use a VITE_ prefix.
PI_TESTNET_API_KEY=
PI_MAINNET_API_KEY=
PI_MAINNET_APP_ID=
PI_MAINNET_WALLET_ADDRESS=
CRYPTOID_APP_NETWORK=
CRYPTOID_CODE_REVISION=
CRYPTOID_NOTIFICATIONS_ENABLED=0
